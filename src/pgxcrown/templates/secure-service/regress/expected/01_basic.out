CREATE FUNCTION pg_temp.check_empty_label() RETURNS text LANGUAGE plpgsql AS $$
BEGIN
  PERFORM {{project_snake}}_record('   ', 'ignored');
  RETURN 'UNEXPECTED_OK';
EXCEPTION WHEN invalid_parameter_value THEN
  RETURN 'REJECTED_22023';
END $$;
