{
  "name": "hook-observability",
  "description": "PostgreSQL post_parse_analyze observability hook extension with safe hook chaining and stats UDFs",
  "minPgxcrownVersion": "0.31.0",
  "variables": [
    {
      "name": "hook_label",
      "default": "observability",
      "pattern": "^[A-Za-z0-9_-]{1,32}$"
    }
  ],
  "files": [
    "pgxext.json",
    "src/main.nim",
    {"src": "regress/sql/01_basic.sql", "dest": "tests/sql/01_basic.sql"},
    {"src": "regress/expected/01_basic.out", "dest": "tests/expected/01_basic.out"},
    "README.md"
  ]
}
