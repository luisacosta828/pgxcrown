---------------------------------------------------------------------------
 00000000-0000-0000-0000-000000000000,a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
(1 row)

SELECT u FROM uuid_srf_list() AS u;
                  u
--------------------------------------
