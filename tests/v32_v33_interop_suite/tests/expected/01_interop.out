DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'pgx_interop_lowpriv') THEN
    CREATE ROLE pgx_interop_lowpriv LOGIN NOSUPERUSER;
  END IF;
END $$;
DO
SET ROLE pgx_interop_lowpriv;
SET
BEGIN;
BEGIN
SET LOCAL v32interop.batch_limit = 5;
SET
