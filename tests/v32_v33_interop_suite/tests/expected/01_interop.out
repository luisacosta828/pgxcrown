-----------
 t
(1 row)

SAVEPOINT sp1;
SAVEPOINT
  INSERT INTO interop_events(tag, note, qty) VALUES ('alpha', 'aborted_sub', 99);
INSERT 0 1
ROLLBACK TO SAVEPOINT sp1;
ROLLBACK
SAVEPOINT sp2;
SAVEPOINT
  SELECT interop_record_event('alpha'::"InteropTag", 'hello', 20) > 0 AS rec_val;
 rec_val
---------
 t
(1 row)

RELEASE SAVEPOINT sp2;
RELEASE
COMMIT;
COMMIT
