-- PostgreSQL Xact & SubXact Callbacks E2E Regression Suite
SELECT xact_reset_all() AS init_counts;
   init_counts
------------------
 xact=0|subxact=0
(1 row)

-- 1. COMMIT & ROLLBACK lifecycle with raw + convenience callbacks
BEGIN;
BEGIN
SELECT xact_arm_basic() AS armed_cnt;
 armed_cnt
-----------
         3
(1 row)

SELECT 1 AS work;
 work
------
    1
(1 row)

COMMIT;
COMMIT
BEGIN;
BEGIN
SELECT 2 AS doomed_work;
 doomed_work
-------------
           2
(1 row)

ROLLBACK;
ROLLBACK
SELECT xact_take_log(true) AS commit_and_rollback_log;
                      commit_and_rollback_log
-------------------------------------------------------------------
 raw:xePreCommit | raw:xeCommit | onCommit | raw:xeAbort | onAbort
(1 row)

SELECT xact_counts() AS counts_after_disarm;
 counts_after_disarm
---------------------
 xact=0|subxact=0
(1 row)

-- 2. SAVEPOINT / ROLLBACK TO SAVEPOINT / RELEASE SAVEPOINT / COMMIT subxact lifecycle
BEGIN;
BEGIN
SELECT xact_arm_subxact() AS sub_armed_cnt;
 sub_armed_cnt
---------------
             3
(1 row)

SAVEPOINT sp1;
SAVEPOINT
  SAVEPOINT sp2;
SAVEPOINT
  ROLLBACK TO SAVEPOINT sp2;
ROLLBACK
  RELEASE SAVEPOINT sp2;
RELEASE
COMMIT;
COMMIT
SELECT xact_take_log(true) AS subxact_commit_log;
                                                                                                                               subxact_commit_log
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 raw:sxeStartSub(2<-1) | raw:sxeStartSub(3<-2) | raw:sxeAbortSub(3<-2) | onSubXactAbort(3<-2) | raw:sxeStartSub(4<-2) | raw:sxePreCommitSub(4<-2) | raw:sxeCommitSub(4<-2) | onSubXactCommit(4<-2) | raw:sxePreCommitSub(2<-1) | raw:sxeCommitSub(2<-1) | onSubXactCommit(2<-1)
(1 row)

-- Subxact abort via top-level ROLLBACK
BEGIN;
BEGIN
SELECT xact_arm_subxact() AS sub_armed_abort_cnt;
 sub_armed_abort_cnt
---------------------
                   3
(1 row)

SAVEPOINT sp_outer;
SAVEPOINT
ROLLBACK;
ROLLBACK
SELECT xact_take_log(true) AS subxact_rollback_log;
                         subxact_rollback_log
----------------------------------------------------------------------
 raw:sxeStartSub(2<-1) | raw:sxeAbortSub(2<-1) | onSubXactAbort(2<-1)
(1 row)

-- 3. Anti-PANIC shield: Nim error in xeAbort must emit WARNING and NOT crash server
BEGIN;
BEGIN
SELECT xact_arm_panic_shield('abort_exc') AS armed_abort_exc;
 armed_abort_exc
-----------------
               2
(1 row)

ROLLBACK;
psql:/tmp/current_test.sql:37: WARNING:  pgxcrown xeAbort callback error [ValueError]: nim error in abort
ROLLBACK
SELECT xact_take_log(true) AS abort_exc_log;
            abort_exc_log
-------------------------------------
 abort_throw_before | abort_tail_ran
(1 row)

-- Anti-PANIC shield: direct C pgError (ereport ERROR) in xeAbort must emit WARNING
BEGIN;
BEGIN
SELECT xact_arm_panic_shield('abort_pgerror') AS armed_abort_pgerr;
 armed_abort_pgerr
-------------------
                 2
(1 row)

ROLLBACK;
psql:/tmp/current_test.sql:43: WARNING:  pgxcrown xeAbort callback PostgreSQL error: direct pgError in abort
ROLLBACK
SELECT xact_take_log(true) AS abort_pgerr_log;
                abort_pgerr_log
-----------------------------------------------
 abort_pgerror_before | abort_pgerror_tail_ran
(1 row)

-- Anti-PANIC shield: Nim Defect in xeCommit must emit WARNING and NOT crash server
BEGIN;
BEGIN
SELECT xact_arm_panic_shield('commit_defect') AS armed_commit_def;
 armed_commit_def
------------------
                2
(1 row)

COMMIT;
psql:/tmp/current_test.sql:49: WARNING:  pgxcrown xeCommit callback defect [IndexDefect]: index 5 not in 0 .. 1
COMMIT
SELECT xact_take_log(true) AS commit_def_log;
             commit_def_log
----------------------------------------
 commit_defect_before | commit_tail_ran
(1 row)

-- Anti-PANIC shield: errors in sxeAbortSub and sxeCommitSub emit WARNING
BEGIN;
BEGIN
SELECT xact_arm_panic_shield('subxact_exc') AS armed_sub_exc;
 armed_sub_exc
---------------
             4
(1 row)

SAVEPOINT sp_a;
SAVEPOINT
ROLLBACK TO SAVEPOINT sp_a;
psql:/tmp/current_test.sql:56: WARNING:  pgxcrown sxeAbortSub callback error [ValueError]: nim error in subxact abort
ROLLBACK
RELEASE SAVEPOINT sp_a;
psql:/tmp/current_test.sql:57: WARNING:  pgxcrown sxeCommitSub callback PostgreSQL error: direct pgError in subxact commit
RELEASE
COMMIT;
COMMIT
SELECT xact_take_log(true) AS subxact_exc_log;
                                       subxact_exc_log
---------------------------------------------------------------------------------------------
 sub_abort_throw_before | sub_abort_tail_ran | sub_commit_throw_before | sub_commit_tail_ran
(1 row)

-- 4. Pre-commit failures must abort transaction cleanly with controlled ERROR
BEGIN;
BEGIN
SELECT xact_arm_precommit_fail('pgerror') AS armed_precommit_pgerr;
 armed_precommit_pgerr
-----------------------
                     2
(1 row)

COMMIT;
psql:/tmp/current_test.sql:64: ERROR:  blocked by pre-commit policy
DETAIL:  policy=strict
HINT:  fix transaction
SELECT xact_take_log(true) AS precommit_pgerr_log;
                 precommit_pgerr_log
------------------------------------------------------
 precommit_about_to_fail | abort_after_precommit_fail
(1 row)

BEGIN;
BEGIN
SELECT xact_arm_precommit_fail('defect') AS armed_precommit_def;
 armed_precommit_def
---------------------
                   2
(1 row)

COMMIT;
psql:/tmp/current_test.sql:69: ERROR:  Extension Defect [IndexDefect]: index 9 not in 0 .. 0
SELECT xact_take_log(true) AS precommit_def_log;
 precommit_def_log
--------------------
 abort_after_defect
(1 row)

BEGIN;
BEGIN
SELECT xact_arm_precommit_fail('sub') AS armed_sub_precommit;
 armed_sub_precommit
---------------------
                   2
(1 row)

SAVEPOINT sp_fail;
SAVEPOINT
RELEASE SAVEPOINT sp_fail;
psql:/tmp/current_test.sql:75: ERROR:  blocked subxact pre-commit
ROLLBACK;
ROLLBACK
SELECT xact_take_log(true) AS sub_precommit_log;
                  sub_precommit_log
-----------------------------------------------------
 sub_precommit_fail | sub_abort_after_precommit_fail
(1 row)

